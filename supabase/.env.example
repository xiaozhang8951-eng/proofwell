# EDGE FUNCTION SECRETS ONLY — never use NEXT_PUBLIC_ for these.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase's runtime.
COMMUNITY_ENABLED=false
COMMUNITY_ALLOWED_ORIGINS=https://proofwelllife.com
COMMUNITY_REQUIRE_TURNSTILE=true
TURNSTILE_SECRET_KEY=
COMMUNITY_IP_HASH_SECRET=
# Shared only with the Cloudflare Pages Function; never NEXT_PUBLIC_.
COMMUNITY_GATEWAY_SECRET=
# Direct requests and raw client forwarding headers are always rejected.
