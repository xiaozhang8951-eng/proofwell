# Set the real canonical origin before public launch.
NEXT_PUBLIC_SITE_URL=

# Community is opt-in and remains unavailable until reviewed backend setup is complete.
NEXT_PUBLIC_COMMUNITY_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_COMMUNITY_TURNSTILE_SITE_KEY=
# Match Supabase Auth CAPTCHA settings; use a separate fresh token for each write.
NEXT_PUBLIC_COMMUNITY_AUTH_CAPTCHA=true
# Separate default-deny gate; enable only after actual CMP + existing GTM mapping review.
NEXT_PUBLIC_COMMUNITY_ANALYTICS_ENABLED=false
